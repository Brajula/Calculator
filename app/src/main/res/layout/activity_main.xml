<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAF8"
    android:fillViewport="true"
    android:padding="28dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kalkulator"
            android:textSize="26sp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="-0.04"
            android:textColor="#202822" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Twój kalkulator ocen"
            android:textSize="14sp"
            android:textColor="#6A726C" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="28dp"
            android:background="#E1E5DF" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Zacznij od swoich danych"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#202822" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:text="Wpisz punkty, a my przeliczymy je na ocenę."
            android:textSize="14sp"
            android:lineSpacingExtra="3dp"
            android:textColor="#6A726C" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:labelFor="@+id/etFirstName"
            android:text="Imię"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#49564D" />

        <EditText
            android:id="@id/etFirstName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"
            android:backgroundTint="#788C7C"
            android:hint="np. Jan"
            android:inputType="textPersonName|textCapWords"
            android:imeOptions="actionNext"
            android:singleLine="true"
            android:textColor="#202822"
            android:textColorHint="#7A827C"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:labelFor="@+id/etLastName"
            android:text="Nazwisko"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#49564D" />

        <EditText
            android:id="@id/etLastName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"
            android:backgroundTint="#788C7C"
            android:hint="np. Kowalski"
            android:inputType="textPersonName|textCapWords"
            android:imeOptions="actionNext"
            android:singleLine="true"
            android:textColor="#202822"
            android:textColorHint="#7A827C"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:labelFor="@+id/etPoints"
            android:text="Liczba punktów"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#49564D" />

        <EditText
            android:id="@id/etPoints"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:layout_marginTop="4dp"
            android:backgroundTint="#788C7C"
            android:hint="np. 75"
            android:inputType="number"
            android:imeOptions="actionDone"
            android:singleLine="true"
            android:textColor="#202822"
            android:textColorHint="#7A827C"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Zaliczenie od 50 punktów"
            android:textSize="12sp"
            android:textColor="#6A726C" />

        <Button
            android:id="@+id/btnCalculate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="#263C30"
            android:text="Oblicz ocenę"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="24dp"
            android:background="#E1E5DF" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TWÓJ WYNIK"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:textColor="#49564D" />

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Tutaj pojawi się podsumowanie."
            android:textSize="16sp"
            android:textColor="#202822"
            android:lineSpacingExtra="6dp"
            android:accessibilityLiveRegion="polite" />

    </LinearLayout>

</ScrollView>